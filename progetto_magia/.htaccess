# Progetto Magia - Configurazione Apache

# Abilita RewriteEngine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /progetto_magia/

    # Forza HTTPS (decommenta se hai SSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Rimuovi trailing slash (opzionale)
    # RewriteCond %{REQUEST_FILENAME} !-d
    # RewriteRule ^(.*)/$ /$1 [L,R=301]
</IfModule>

# Protezione file sensibili
<FilesMatch "^(config\.php|\.env|\.gitignore|\.htaccess)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Blocca accesso a directory senza index
Options -Indexes

# Blocca database_setup.php dopo prima esecuzione (decommenta dopo setup)
# <Files "database_setup.php">
#     Order allow,deny
#     Deny from all
# </Files>

# Proteggi file .git
<DirectoryMatch "\.git">
    Order deny,allow
    Deny from all
</DirectoryMatch>

# Prevenzione XSS
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compressione GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache statica
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# Charset UTF-8
AddDefaultCharset UTF-8

# Limita dimensione upload (se necessario, modifica php.ini)
php_value upload_max_filesize 20M
php_value post_max_size 20M
php_value max_execution_time 300
php_value max_input_time 300
